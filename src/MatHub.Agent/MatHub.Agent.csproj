<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The MatHub agent: a Windows service (and a console program for install, uninstall and the self-update). It shares the version of the server
    (Directory.Build.props): the image builds both, so the agent a server hands out is always its own.
      dotnet publish src/MatHub.Agent -c Release -r win-x64   ->   mathub-agent.exe (one file, .NET inside)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <RootNamespace>MatHub.Agent</RootNamespace>
    <AssemblyName>mathub-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- one file with .NET inside, for a computer that has no .NET -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- the protocol: one file for the server and the agent -->
    <Compile Include="..\MatHub.Shared\AgentProtocol.cs" Link="Protocol\AgentProtocol.cs" />
    <InternalsVisibleTo Include="MatHub.Tests" />
  </ItemGroup>

</Project>

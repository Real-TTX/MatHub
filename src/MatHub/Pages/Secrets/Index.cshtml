@page "/secrets"
@model MatHub.Pages.Secrets.IndexModel
@{
    ViewData["Title"] = L["Secrets.Title"].Value;
    ViewData["PageSub"] = L["Secrets.Sub"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Scripts.Title"].Value, "/scripts"), (L["Secrets.Title"].Value, null) };
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    @if (Model.Items.Count == 0)
    {
        var first = Model.Toolbar.Total == 0;
        <partial name="_Empty" model="@(new EmptyStateModel("key", L[first ? "Secrets.Empty" : "Secrets.NoMatch"].Value, L[first ? "Secrets.EmptyText" : "Lists.ChangeTools"].Value, first, "/secrets/edit", L["Secrets.New"].Value, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <mh-table caption="@L["Secrets.Title"]">
            <thead><tr><th scope="col">@L["Common.Name"]</th><th scope="col">@L["Secrets.UserName"]</th><th scope="col" class="mat-hide-md">@L["Common.Description"]</th><th scope="col" class="mat-num mat-hide-sm">@L["Secrets.UsedBy"]</th><th scope="col" class="mat-hide-sm">@L["Common.Updated"]</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td data-label="@L["Common.Name"]" class="mat-table__primary"><a href="/secrets/edit?id=@s.Id"><span class="mh-name">@Ui.Icon("key")<code class="mh-code-name">@s.Name</code></span></a></td>
                        <td data-label="@L["Secrets.UserName"]">@if (s.UserName is not null) { <span class="mat-mono">@s.UserName</span> } else { <span class="mh-muted">–</span> }</td>
                        <td data-label="@L["Common.Description"]" class="mat-hide-md">@s.Description</td>
                        <td data-label="@L["Secrets.UsedBy"]" class="mat-num mat-hide-sm">@s.Scripts</td>
                        <td data-label="@L["Common.Updated"]" class="mat-hide-sm mh-nowrap">@Ui.When(s.Updated, Model.Zone)</td>
                    </tr>
                }
            </tbody>
        </mh-table>
    }
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/secrets/edit">@Ui.Icon("plus")<span>@L["Secrets.New"]</span></a>
    </div>
</div>

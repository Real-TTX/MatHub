@page "/secrets/edit"
@model MatHub.Pages.Secrets.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["Secrets.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Scripts.Title"].Value, "/scripts"), (L["Secrets.Title"].Value, "/secrets"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    var shown = string.IsNullOrWhiteSpace(Model.Name) ? "NAME" : MatHub.Services.Scripts.SecretService.Normalize(Model.Name);
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate autocomplete="off">
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <mh-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="60" mono placeholder="DOMAIN_JOIN" hint="@L["Secrets.Name.Hint"]" msg-required="@L["Common.NameRequired"]" />
                    <mh-field name="UserName" label="@L["Secrets.UserName"]" value="@Model.UserName" maxlength="200" optional mono placeholder="CONTOSO\svc-join" hint="@L["Secrets.UserName.Hint"]" autocomplete="off" />
                    <mh-field name="Value" kind="password" label="@L["Secrets.Value"]" maxlength="1000" required="@Model.IsNew" optional="@(!Model.IsNew)" autocomplete="new-password" hint="@L[Model.IsNew ? "Secrets.Value.Hint" : "Secrets.Value.Keep"]" />
                    <mh-field name="Description" kind="textarea" label="@L["Common.Description"]" value="@Model.Description" maxlength="500" rows="2" optional />
                </div>
            </div>
            <mh-buttons save="@L["Common.Save"]" back="/secrets" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="@L["Secrets.Delete"]" delete-confirm="@L["Secrets.DeleteConfirm", Model.Name]" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <section class="mat-card" aria-labelledby="secret-use">
            <div class="mat-card__head"><h2 class="mat-card__title" id="secret-use">@Ui.Icon("code")@L["Secrets.Use"]</h2></div>
            <div class="mat-card__body">
                <p class="mat-muted mh-mb">@L["Secrets.Use.Blocks"]</p>
                <p class="mat-muted mh-mb">@L["Secrets.Use.Code"]</p>
                <pre class="mat-code"><code>$password = Get-MatHubSecret '@shown'
$credential = New-MatHubCredential '@shown' ''
$env:MATHUB_SECRET_@shown</code></pre>
            </div>
        </section>
        <section class="mat-card" aria-labelledby="secret-safe">
            <div class="mat-card__head"><h2 class="mat-card__title" id="secret-safe">@Ui.Icon("shield")@L["Secrets.Safety"]</h2></div>
            <div class="mat-card__body">
                <ul class="mh-checklist">
                    <li>@Ui.Icon("check")<span>@L["Secrets.Safety.Encrypted"]</span></li>
                    <li>@Ui.Icon("check")<span>@L["Secrets.Safety.OnlyRun"]</span></li>
                    <li>@Ui.Icon("check")<span>@L["Secrets.Safety.Masked"]</span></li>
                    <li>@Ui.Icon("alert")<span>@L["Secrets.Safety.Authors"]</span></li>
                </ul>
            </div>
        </section>
    </div>
</div>

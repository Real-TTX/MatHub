@page "/groups/edit"
@model MatHub.Pages.Groups.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["Groups.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Groups.Title"].Value, "/groups"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-6">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <mh-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" msg-required="@L["Common.NameRequired"]" disabled="@(!Model.CanManage)" />
                    <mh-field name="Description" kind="textarea" label="@L["Common.Description"]" value="@Model.Description" maxlength="1000" rows="2" optional disabled="@(!Model.CanManage)" />
                    <mh-field name="Colour" kind="colour" label="@L["Common.Color"]" value="@Model.Colour" optional disabled="@(!Model.CanManage)" />
                    <mh-field name="Kind" kind="radios" label="@L["Groups.Kind"]" value="@Model.Kind" options="Model.Kinds" disabled="@(!Model.CanManage)" />
                    @* the rule: only for a group whose members MatHub finds by itself *@
                    <fieldset class="mat-fieldset mh-rule" data-show-if="Kind" data-show-value="Dynamic">
                        <legend class="mat-legend">@L["Groups.Rule"]</legend>
                        <div class="mat-cols">
                            <div class="mat-col-12 mat-col-md-4"><mh-field name="RuleField" kind="select" label="@L["Groups.RuleField"]" value="@Model.RuleField" options="Model.Fields" disabled="@(!Model.CanManage)" /></div>
                            <div class="mat-col-12 mat-col-md-4"><mh-field name="RuleOperator" kind="select" label="@L["Groups.RuleOperator"]" value="@Model.RuleOperator" options="Model.Operators" disabled="@(!Model.CanManage)" /></div>
                            <div class="mat-col-12 mat-col-md-4"><mh-field name="RuleValue" label="@L["Groups.RuleValue"]" value="@Model.RuleValue" maxlength="200" placeholder="NB-" disabled="@(!Model.CanManage)" /></div>
                        </div>
                        <p class="mat-hint">@L["Groups.Rule.Hint"]</p>
                    </fieldset>
                </div>
            </div>
            @if (Model.CanManage)
            {
                <mh-buttons save="@L[Model.IsNew ? "Common.Create" : "Common.Save"]" back="/groups" delete-handler="@(Model.IsNew || !Me.Actor.ReachesAll ? null : "Delete")" delete-label="@L["Groups.Delete"]" delete-confirm="@L["Groups.DeleteConfirm", Model.Name]" />
            }
            else
            {
                <mh-buttons back="/groups" />
            }
        </form>
    </div>
    @if (!Model.IsNew)
    {
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("monitor")@L["Groups.Members"] <span class="mat-badge">@Model.Members.Count</span></h2></div>
                <div class="mat-card__body">
                    @if (Model.Members.Count == 0)
                    {
                        <p class="mh-muted">@L[Model.Kind == GroupKind.Dynamic ? "Groups.NoMembers.Dynamic" : "Groups.NoMembers.Static"]</p>
                    }
                    else
                    {
                        <ul class="mat-itemlist">
                            @foreach (var m in Model.Members)
                            {
                                <li class="mat-item">
                                    <a class="mat-item__main" href="/clients/@m.Id">
                                        <span class="mat-item__lead">@Ui.Icon("monitor")</span>
                                        <span class="mat-item__body"><span class="mat-item__title">@m.Name</span><span class="mat-item__text">@m.OperatingSystem</span></span>
                                        <span class="mat-item__end"><partial name="_ClientState" model="(m.Status, m.Online)" /></span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

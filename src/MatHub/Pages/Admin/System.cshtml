@page "/Admin/System"
@model MatHub.Pages.Admin.SystemModel
@{
    ViewData["Title"] = L["System.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["System.Title"].Value, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("settings")@L["System.Settings"]</h2></div>
                <div class="mat-card__body mat-form">
                    <mh-field name="RegistrationOpen" kind="switch" label="@L["System.RegistrationOpen"]" value="@Model.RegistrationOpen.ToString()" hint="@L["System.RegistrationOpen.Hint"]" />
                    <mh-field name="PublicUrl" kind="url" label="@L["System.PublicUrl"]" value="@Model.PublicUrl" placeholder="https://hub.example.com" optional="@(!Model.PublicUrlFixed)" disabled="@Model.PublicUrlFixed" hint="@L[Model.PublicUrlFixed ? "System.PublicUrl.Fixed" : "System.PublicUrl.Hint"]" />
                </div>
            </div>
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("mathub")@L["System.Agents"]</h2></div>
                <div class="mat-card__body mat-form">
                    <mh-field name="AgentPollSeconds" kind="number" label="@L["System.AgentPollSeconds"]" value="@Model.AgentPollSeconds" min="10" max="3600" hint="@L["System.AgentPollSeconds.Hint"]" />
                    <mh-field name="InventoryHours" kind="number" label="@L["System.InventoryHours"]" value="@Model.InventoryHours" min="1" max="168" />
                    <mh-field name="JobDays" kind="number" label="@L["System.JobDays"]" value="@Model.JobDays" min="1" max="3650" hint="@L["System.JobDays.Hint"]" />
                </div>
            </div>
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("server")@L["System.Netboot"]</h2></div>
                <div class="mat-card__body mat-form">
                    <mh-field name="BootUrl" kind="url" label="@L["System.BootUrl"]" value="@Model.BootUrl" placeholder="http://10.0.0.5:4910" optional hint="@L["System.BootUrl.Hint"]" />
                </div>
            </div>
            <mh-buttons save="@L["Common.Save"]" back="/" />
        </form>
        <form method="post" asp-page-handler="CleanUp" class="mh-mt">
            <button type="submit" class="mat-btn mat-btn--secondary" data-confirm="@L["System.CleanUp.Confirm"]" data-confirm-ok="@L["System.CleanUp"]">@Ui.Icon("broom")<span>@L["System.CleanUp"]</span></button>
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["System.About"]</h2></div>
            <div class="mat-card__body">
                <dl class="mh-dl">
                    <dt>@L["System.Version"]</dt><dd class="mat-mono">@AppInfo.Version</dd>
                    <dt>@L["System.AgentVersion"]</dt><dd class="mat-mono">@(Model.Agent.Available ? Model.Agent.Version : L["System.AgentMissing"].Value)</dd>
                    <dt>@L["System.Database"]</dt><dd class="mat-mono">@Model.Database</dd>
                    <dt>@L["Users.Title"]</dt><dd>@Model.Counts.Users</dd>
                    <dt>@L["Clients.Title"]</dt><dd>@Model.Counts.Clients</dd>
                    <dt>@L["Scripts.Title"]</dt><dd>@Model.Counts.Scripts</dd>
                    <dt>@L["Packages.Title"]</dt><dd>@Model.Counts.Packages</dd>
                    <dt>@L["System.Mail"]</dt><dd>@(Model.MailText ?? L["System.Mail.Off"].Value)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@page "/clients/{id:long}/software"
@model MatHub.Pages.Clients.SoftwareModel
@using MatHub.Services.Packages
@{
    var c = Model.Client;
    ViewData["Title"] = c.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Clients.Title"].Value, "/clients"), (c.Name, $"/clients/{c.Id}"), (L["Clients.Tab.Software"].Value, null) };
    ViewData["Tab"] = "software";
}

<partial name="_ClientHead" model="Model" />

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    @if (Model.Items.Count == 0)
    {
        var first = Model.Toolbar.Total == 0;
        <partial name="_Empty" model="@(new EmptyStateModel("box", L[first ? "Software.None" : "Software.NoMatch"].Value, L[first ? "Inventory.NoneText" : "Lists.ChangeTools"].Value, false, null, null, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <mh-table caption="@L["Clients.Tab.Software"]">
            <thead>
                <tr>
                    <th scope="col">@L["Common.Name"]</th>
                    <th scope="col">@L["Software.Version"]</th>
                    <th scope="col" class="mat-hide-md">@L["Software.Publisher"]</th>
                    <th scope="col" class="mat-hide-sm">@L["Software.WingetId"]</th>
                    <th scope="col">@L["Software.Update"]</th>
                    <th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td data-label="@L["Common.Name"]" class="mat-table__primary">@if (s.WingetId is not null && Model.Packages.TryGetValue(s.WingetId, out var packageId)) { <a class="mh-name" href="/packages/edit?id=@packageId">@Ui.Icon("box")@s.Name</a> } else { <span>@s.Name</span> }</td>
                        <td data-label="@L["Software.Version"]" class="mat-mono">@s.Version</td>
                        <td data-label="@L["Software.Publisher"]" class="mat-hide-md">@s.Publisher</td>
                        <td data-label="@L["Software.WingetId"]" class="mat-mono mat-hide-sm">@s.WingetId</td>
                        <td data-label="@L["Software.Update"]" class="mat-table__keep-label">@if (s.AvailableVersion is not null) { <span class="mat-pill mat-pill--accent">@s.AvailableVersion</span> }</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                @if (Model.CanMakePackage && s.WingetId is not null && !Model.Packages.ContainsKey(s.WingetId))
                                {
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@PackageService.NewFromWingetUrl(s.WingetId, s.Name, s.Publisher)" aria-label="@L["Software.MakePackageNamed", s.Name]" data-tip="@L["Software.MakePackage"]">@Ui.Icon("plus")</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </mh-table>
    }

    @if (Model.UpdateCount > 0)
    {
        <p class="mat-hint mh-mt">@Ui.Icon("info") @L["Software.UpdatesThroughVersions"] <a href="/updates">@L["Updates.Title"]</a></p>
    }
</div>

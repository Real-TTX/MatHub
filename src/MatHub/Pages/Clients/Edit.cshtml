@page "/clients/{id:long}"
@model MatHub.Pages.Clients.EditModel
@using MatHub.Services.Access
@{
    var c = Model.Client;
    ViewData["Title"] = c.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Clients.Title"].Value, "/clients"), (c.Name, null) };
    ViewData["Tab"] = "general";
}

<partial name="_ClientHead" model="Model" />

@if (c.Status == ClientStatus.Pending)
{
    <div class="mat-alert mat-alert--warning" role="status">
        @Ui.Icon("clock")
        <div class="mat-alert__body">
            <strong class="mat-alert__title">@L["Clients.PendingTitle"]</strong>
            <p>@L["Clients.PendingText"]</p>
            @if (Me.Can(Permission.ClientsEnroll))
            {
                <form method="post" asp-page-handler="Approve" class="mat-alert__actions">
                    <button type="submit" class="mat-btn mat-btn--primary mat-btn--sm">@Ui.Icon("check")<span>@L["Clients.Approve"]</span></button>
                </form>
            }
        </div>
    </div>
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("edit")@L["Clients.Details"]</h2></div>
                <div class="mat-card__body mat-form">
                    <mh-field name="Description" kind="textarea" label="@L["Common.Description"]" value="@Model.Description" maxlength="1000" optional rows="3" disabled="@(!Model.CanManage)" />
                    <mh-field name="Tags" kind="tags" label="@L["Clients.Tags"]" value="@Model.Tags" optional hint="@L["Clients.Tags.Hint"]" disabled="@(!Model.CanManage)" />
                    <mh-field name="Groups" kind="select" label="@L["Groups.Title"]" value="@Model.Groups" options="Model.GroupChoices" picker="multiple search" optional hint="@L["Clients.Groups.Hint"]" disabled="@(!Model.CanManage)" />
                </div>
            </div>
            @if (Model.CanManage)
            {
                <mh-buttons save="@L["Common.Save"]" back="/clients" delete-handler="Delete" delete-label="@L["Clients.Delete"]" delete-confirm="@L["Clients.DeleteConfirm", c.Name]" />
            }
            else
            {
                <mh-buttons back="/clients" />
            }
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("monitor")@L["Clients.Facts"]</h2></div>
            <div class="mat-card__body">
                <dl class="mh-dl">
                    <dt>@L["Clients.Col.System"]</dt><dd>@(c.OperatingSystem ?? "–") @if (c.OsBuild is not null) { <span class="mh-muted mat-mono">@c.OsBuild</span> }</dd>
                    <dt>@L["Clients.Domain"]</dt><dd>@(c.Domain ?? "–")</dd>
                    <dt>@L["Clients.Model"]</dt><dd>@(string.Join(" ", new[] { c.Manufacturer, c.Model }.Where(x => x is not null)) is { Length: > 0 } m ? m : "–")</dd>
                    <dt>@L["Clients.Serial"]</dt><dd class="mat-mono">@(c.SerialNumber ?? "–")</dd>
                    <dt>@L["Clients.Col.Address"]</dt><dd class="mat-mono">@(c.IpAddresses ?? "–")</dd>
                    <dt>@L["Clients.Col.User"]</dt><dd>@(c.LastUser ?? "–")</dd>
                    <dt>@L["Clients.Agent"]</dt><dd class="mat-mono">@(c.AgentVersion ?? "–")</dd>
                    <dt>@L["Clients.Enrolled"]</dt><dd>@Dates.Stamp(c.CreateDate, Model.Zone)</dd>
                    <dt>@L["Clients.LastInventory"]</dt><dd>@(c.LastInventoryDate is { } inv ? Dates.Stamp(inv, Model.Zone) : L["Common.Never"].Value)</dd>
                </dl>
            </div>
        </div>
        @if (c.Status != ClientStatus.Pending)
        {
            <section class="mat-card mat-card--flush" aria-labelledby="actions-title">
                <div class="mat-card__head"><h2 class="mat-card__title" id="actions-title">@Ui.Icon("play")@L["Clients.Actions"]</h2></div>
                <div class="mat-card__body">
                    <ul class="mat-itemlist mat-itemlist--lines-inset">
                        @if (Model.CanRun && c.Status == ClientStatus.Active)
                        {
                            <li class="mat-item"><a class="mat-item__main" href="/jobs/new?client=@c.Id">
                                <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--accent">@Ui.Icon("play")</span></span>
                                <span class="mat-item__body"><span class="mat-item__title">@L["Clients.Run"]</span><span class="mat-item__text">@L["Clients.Run.Hint"]</span></span>
                                <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                            </a></li>
                            @if (c.UpdatesAvailable > 0)
                            {
                                <li class="mat-item"><a class="mat-item__main" href="/clients/@c.Id/software?updates=1">
                                    <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--warn">@Ui.Icon("refresh")</span></span>
                                    <span class="mat-item__body"><span class="mat-item__title">@L["Clients.UpdatesWaiting", c.UpdatesAvailable]</span><span class="mat-item__text">@L["Clients.UpdatesWaiting.Hint"]</span></span>
                                    <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                                </a></li>
                            }
                            <li class="mat-item"><a class="mat-item__main" href="/jobs/new?client=@c.Id&amp;kind=Restart">
                                <span class="mat-item__lead"><span class="mat-item__tile">@Ui.Icon("power")</span></span>
                                <span class="mat-item__body"><span class="mat-item__title">@L["Jobs.Kind.Restart"]</span><span class="mat-item__text">@L["Jobs.Kind.Restart.Hint"]</span></span>
                                <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                            </a></li>
                        }
                        <li class="mat-item">
                            <form method="post" asp-page-handler="Inventory" class="mat-item__row">
                                <button type="submit" class="mat-item__main" disabled="@c.InventoryRequested">
                                    <span class="mat-item__lead"><span class="mat-item__tile">@Ui.Icon("list-checks")</span></span>
                                    <span class="mat-item__body"><span class="mat-item__title">@L[c.InventoryRequested ? "Clients.InventoryPending" : "Clients.RequestInventory"]</span><span class="mat-item__text">@L[c.InventoryRequested ? "Clients.InventoryPending.Hint" : "Clients.RequestInventory.Hint"]</span></span>
                                </button>
                            </form>
                        </li>
                        @if (c.Status == ClientStatus.Active && Model.CanManage)
                        {
                            <li class="mat-item">
                                <form method="post" asp-page-handler="Disable" class="mat-item__row">
                                    <button type="submit" class="mat-item__main" data-confirm="@L["Clients.DisableConfirm", c.Name]" data-confirm-ok="@L["Clients.Disable"]">
                                        <span class="mat-item__lead"><span class="mat-item__tile">@Ui.Icon("pause")</span></span>
                                        <span class="mat-item__body"><span class="mat-item__title">@L["Clients.Disable"]</span><span class="mat-item__text">@L["Clients.Disable.Hint"]</span></span>
                                    </button>
                                </form>
                            </li>
                        }
                        else if (c.Status == ClientStatus.Disabled && Me.Can(Permission.ClientsEnroll))
                        {
                            <li class="mat-item">
                                <form method="post" asp-page-handler="Approve" class="mat-item__row">
                                    <button type="submit" class="mat-item__main">
                                        <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--ok">@Ui.Icon("play")</span></span>
                                        <span class="mat-item__body"><span class="mat-item__title">@L["Clients.Enable"]</span><span class="mat-item__text">@L["Clients.Enable.Hint"]</span></span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }
    </div>
</div>

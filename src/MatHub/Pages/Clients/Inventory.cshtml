@page "/clients/{id:long}/inventory"
@model MatHub.Pages.Clients.InventoryModel
@{
    var c = Model.Client;
    ViewData["Title"] = c.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Clients.Title"].Value, "/clients"), (c.Name, $"/clients/{c.Id}"), (L["Clients.Tab.Inventory"].Value, null) };
    ViewData["Tab"] = "inventory";
}

<partial name="_ClientHead" model="Model" />

@if (c.LastInventoryDate is null)
{
    <partial name="_Empty" model="@(new EmptyStateModel("list-checks", L["Inventory.None"].Value, L["Inventory.NoneText"].Value, false))" />
}
else
{
    var disksUsed = c.DiskTotalBytes is > 0 && c.DiskFreeBytes is { } dfree ? (int)Math.Round((c.DiskTotalBytes.Value - dfree) * 100.0 / c.DiskTotalBytes.Value) : 0;
    var hw = Model.Hardware;
    <mh-stats label="@L["Clients.Tab.Inventory"]">
        <mh-stat icon="monitor" label="@L["Clients.Col.System"]" value="@(c.OperatingSystem ?? "–")" hint="@string.Join(" · ", new[] { c.OsVersion, c.OsBuild, c.Architecture }.Where(x => !string.IsNullOrEmpty(x)))" text="true" />
        <mh-stat icon="cpu" label="@L["Inventory.Processor"]" value="@(c.Processor ?? "–")" hint="@(hw?.ProcessorCores is { } cores ? L["Inventory.Cores", cores, hw.ProcessorThreads ?? cores].Value : null)" text="true" />
        <mh-stat icon="database" label="@L["Inventory.Memory"]" value="@(c.MemoryBytes is { } mem ? Ui.Bytes(mem) : "–")" />
        <mh-stat icon="hard-drive" label="@L["Inventory.FreeSpace"]" value="@(c.DiskFreeBytes is { } free ? Ui.Bytes(free) : "–")" hint="@L["Inventory.FreeOf", c.DiskTotalBytes is { } total ? Ui.Bytes(total) : "–"]" tone="@(disksUsed > 90 ? "danger" : disksUsed > 75 ? "warn" : null)" />
    </mh-stats>

    <div class="mat-cols">
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("monitor")@L["Inventory.Hardware"]</h2></div>
                <div class="mat-card__body">
                    <dl class="mh-dl">
                        <dt>@L["Inventory.Manufacturer"]</dt><dd>@(c.Manufacturer ?? "–")</dd>
                        <dt>@L["Clients.Model"]</dt><dd>@(c.Model ?? "–")</dd>
                        <dt>@L["Clients.Serial"]</dt><dd class="mat-mono">@(c.SerialNumber ?? "–")</dd>
                        <dt>@L["Inventory.Bios"]</dt><dd>@(hw?.BiosVersion ?? "–") @if (hw?.BiosDate is { } bd) { <span class="mh-muted">@Dates.Local(bd, Model.Zone).ToString("d", System.Globalization.CultureInfo.CurrentUICulture)</span> }</dd>
                        <dt>@L["Inventory.Platform"]</dt><dd>@(hw?.Platform is { } platform ? L["Versions.Platform." + platform].Value : "–")</dd>
                        <dt>@L["Inventory.Graphics"]</dt><dd>@(hw?.Graphics is { Count: > 0 } g ? string.Join(", ", g) : "–")</dd>
                        <dt>@L["Inventory.SecureBoot"]</dt><dd>@if (hw?.SecureBoot is { } sb) { <span class="mat-pill mat-pill--@(sb ? "ok" : "warn")">@L[sb ? "Inventory.On" : "Inventory.Off"]</span> } else { <span>–</span> }</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("windows")@L["Inventory.System"]</h2></div>
                <div class="mat-card__body">
                    <dl class="mh-dl">
                        <dt>@L["Clients.Col.System"]</dt><dd>@(c.OperatingSystem ?? "–")</dd>
                        <dt>@L["Inventory.Version"]</dt><dd class="mat-mono">@string.Join(" · ", new[] { c.OsVersion, c.OsBuild, c.Architecture }.Where(x => !string.IsNullOrEmpty(x)))</dd>
                        <dt>@L["Inventory.Installed"]</dt><dd>@(hw?.OsInstallDate is { } id ? Dates.Stamp(id, Model.Zone) : "–")</dd>
                        <dt>@L["Clients.Domain"]</dt><dd>@(c.Domain ?? L["Inventory.Workgroup"].Value)</dd>
                        <dt>@L["Clients.Col.User"]</dt><dd>@(c.LastUser ?? "–")</dd>
                        <dt>@L["Inventory.Booted"]</dt><dd>@if (c.BootDate is { } boot) { @Dates.Stamp(boot, Model.Zone) <span class="mh-muted">@L["Inventory.Uptime", Model.Uptime(boot)]</span> } else { <span>–</span> }</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mat-cols mh-mt">
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("hard-drive")@L["Inventory.Disks"]</h2></div>
                <div class="mat-card__body">
                    <mh-table caption="@L["Inventory.Disks"]">
                        <thead><tr><th scope="col">@L["Inventory.Drive"]</th><th scope="col" class="mat-hide-sm">@L["Inventory.FileSystem"]</th><th scope="col">@L["Inventory.Used"]</th><th scope="col" class="mat-num">@L["Inventory.Free"]</th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.Disks)
                            {
                                var used = d.TotalBytes > 0 ? (int)Math.Round((d.TotalBytes - d.FreeBytes) * 100.0 / d.TotalBytes) : 0;
                                <tr>
                                    <td data-label="@L["Inventory.Drive"]" class="mat-mono">@d.Name</td>
                                    <td data-label="@L["Inventory.FileSystem"]" class="mat-hide-sm">@d.FileSystem</td>
                                    <td data-label="@L["Inventory.Used"]"><div class="mat-meter mat-meter--sm" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@used" aria-label="@L["Inventory.Used"]"><div class="mat-meter__fill" data-value="@used" data-tone="@(used > 90 ? "error" : used > 75 ? "warn" : null)"></div></div></td>
                                    <td data-label="@L["Inventory.Free"]" class="mat-num mat-mono">@Ui.Bytes(d.FreeBytes) / @Ui.Bytes(d.TotalBytes)</td>
                                </tr>
                            }
                        </tbody>
                    </mh-table>
                </div>
            </div>
        </div>
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("network")@L["Inventory.Network"]</h2></div>
                <div class="mat-card__body">
                    <mh-table caption="@L["Inventory.Network"]">
                        <thead><tr><th scope="col">@L["Inventory.Adapter"]</th><th scope="col">@L["Inventory.Mac"]</th><th scope="col">@L["Clients.Col.Address"]</th></tr></thead>
                        <tbody>
                            @foreach (var n in Model.Network)
                            {
                                <tr>
                                    <td data-label="@L["Inventory.Adapter"]">@n.Name</td>
                                    <td data-label="@L["Inventory.Mac"]" class="mat-mono">@n.MacAddress</td>
                                    <td data-label="@L["Clients.Col.Address"]" class="mat-mono">@string.Join(", ", n.Addresses)</td>
                                </tr>
                            }
                        </tbody>
                    </mh-table>
                </div>
            </div>
        </div>
    </div>
    <p class="mat-hint mh-mt">@L["Inventory.From", Dates.Stamp(c.LastInventoryDate, Model.Zone)]</p>
}

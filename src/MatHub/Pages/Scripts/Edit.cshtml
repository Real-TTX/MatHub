@page "/scripts/edit"
@model MatHub.Pages.Scripts.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["Scripts.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Scripts.Title"].Value, "/scripts"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    ViewData["Tab"] = "general";
}

@if (!Model.IsNew)
{
    <partial name="_ScriptTabs" model="Model.Id!.Value" />
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <mh-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" msg-required="@L["Common.NameRequired"]" disabled="@(!Model.CanEdit)" />
                    <mh-field name="Description" kind="textarea" label="@L["Common.Description"]" value="@Model.Description" maxlength="1000" rows="2" optional disabled="@(!Model.CanEdit)" />
                    <mh-field name="Category" label="@L["Scripts.Category"]" value="@Model.Category" maxlength="60" optional placeholder="@L["Scripts.Category.Placeholder"]" disabled="@(!Model.CanEdit)" />
                    <mh-field name="Editor" kind="radios" label="@L["Scripts.Editor"]" value="@Model.Editor" options="Model.Editors" disabled="@(!Model.CanEdit)" hint="@(Model.IsNew ? null : L["Scripts.Editor.Change"].Value)" />
                    @* the language: only for code, the visual editors write PowerShell *@
                    <mh-field name="Language" kind="radios" label="@L["Scripts.Language"]" value="@Model.Language" options="Model.Languages" show-if="Editor" show-value="Code" disabled="@(!Model.CanEdit)" />
                    <mh-field name="TimeoutMinutes" kind="number" label="@L["Scripts.Timeout"]" value="@Model.TimeoutMinutes" min="1" max="1440" hint="@L["Scripts.Timeout.Hint"]" disabled="@(!Model.CanEdit)" />
                </div>
            </div>
            @if (Model.CanEdit)
            {
                <mh-buttons save="@L[Model.IsNew ? "Scripts.CreateAndEdit" : "Common.Save"]" back="/scripts" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="@L["Scripts.Delete"]" delete-confirm="@L["Scripts.DeleteConfirm", Model.Name]" />
            }
            else
            {
                <mh-buttons back="/scripts" />
            }
        </form>
    </div>
    @if (Model.IsNew && Model.CanEdit)
    {
        <div class="mat-col-12 mat-col-lg-5">
            <section class="mat-card mat-card--flush" aria-labelledby="script-templates">
                <div class="mat-card__head"><h2 class="mat-card__title" id="script-templates">@Ui.Icon("template")@L["Scripts.Templates"]</h2></div>
                <div class="mat-card__body">
                    <p class="mat-muted mh-card-intro">@L["Scripts.Templates.Hint"]</p>
                    <ul class="mat-itemlist mat-itemlist--lines-inset">
                        @foreach (var t in Model.Templates)
                        {
                            <li class="mat-item">
                                <form method="post" asp-page-handler="Template" class="mat-item__row">
                                    <input type="hidden" name="key" value="@t.Key" />
                                    <button type="submit" class="mat-item__main">
                                        <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--accent">@Ui.Icon(t.Icon)</span></span>
                                        <span class="mat-item__body"><span class="mat-item__title">@L["Templates." + t.Key + ".Name"]</span><span class="mat-item__text">@L["Templates." + t.Key + ".Hint"]</span></span>
                                        <span class="mat-pill mat-pill--plain">@L["Scripts.Editor." + t.Editor]</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        </div>
    }
    @if (!Model.IsNew)
    {
        <div class="mat-col-12 mat-col-lg-5">
            <section class="mat-card mat-card--flush" aria-labelledby="script-actions">
                <div class="mat-card__head"><h2 class="mat-card__title" id="script-actions">@Ui.Icon("play")@L["Clients.Actions"]</h2></div>
                <div class="mat-card__body">
                    <ul class="mat-itemlist mat-itemlist--lines-inset">
                        <li class="mat-item"><a class="mat-item__main" href="/scripts/@Model.Id/code">
                            <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--accent">@Ui.Icon(JobUi.EditorIcon(Model.Editor))</span></span>
                            <span class="mat-item__body"><span class="mat-item__title">@L["Scripts.OpenEditor"]</span><span class="mat-item__text">@L["Scripts.Editor." + Model.Editor + ".Hint"]</span></span>
                            <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                        </a></li>
                        @if (Model.CanRun)
                        {
                            <li class="mat-item"><a class="mat-item__main" href="/jobs/new?script=@Model.Id">
                                <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--ok">@Ui.Icon("play")</span></span>
                                <span class="mat-item__body"><span class="mat-item__title">@L["Scripts.Run"]</span><span class="mat-item__text">@L["Scripts.Run.Hint"]</span></span>
                                <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                            </a></li>
                        }
                        @if (Model.CanKiosk)
                        {
                            <li class="mat-item"><a class="mat-item__main" href="/kiosk/edit?script=@Model.Id">
                                <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--accent">@Ui.Icon("store")</span></span>
                                <span class="mat-item__body"><span class="mat-item__title">@L["Kiosk.Offer"]</span><span class="mat-item__text">@L["Kiosk.Offer.Hint"]</span></span>
                                <span class="mat-item__chevron">@Ui.Icon("chevron-right")</span>
                            </a></li>
                        }
                        @if (Model.CanEdit && Model.Editor == ScriptEditor.Blocks)
                        {
                            <li class="mat-item">
                                <form method="post" asp-page-handler="Flow" asp-route-id="@Model.Id" class="mat-item__row">
                                    <button type="submit" class="mat-item__main">
                                        <span class="mat-item__lead"><span class="mat-item__tile mat-item__tile--info">@Ui.Icon("flow")</span></span>
                                        <span class="mat-item__body"><span class="mat-item__title">@L["Scripts.CopyAsFlow"]</span><span class="mat-item__text">@L["Scripts.CopyAsFlow.Hint"]</span></span>
                                    </button>
                                </form>
                            </li>
                        }
                        @if (Model.CanEdit)
                        {
                            <li class="mat-item">
                                <form method="post" asp-page-handler="Duplicate" asp-route-id="@Model.Id" class="mat-item__row">
                                    <button type="submit" class="mat-item__main">
                                        <span class="mat-item__lead"><span class="mat-item__tile">@Ui.Icon("copy")</span></span>
                                        <span class="mat-item__body"><span class="mat-item__title">@L["Scripts.Duplicate"]</span><span class="mat-item__text">@L["Scripts.Duplicate.Hint"]</span></span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        </div>
    }
</div>

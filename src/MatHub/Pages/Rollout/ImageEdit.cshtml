@page "/rollout/images/edit"
@model MatHub.Pages.Rollout.ImageEditModel
@{
    ViewData["Title"] = Model.IsNew ? L["Images.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Shell.Group.Rollout"].Value, null), (L["Images.Title"].Value, "/rollout/images"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    var ro = !Model.CanManage;
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-6">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <mh-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" msg-required="@L["Common.NameRequired"]" disabled="@ro" />
                    <mh-field name="Description" kind="textarea" label="@L["Common.Description"]" value="@Model.Description" rows="2" maxlength="1000" optional disabled="@ro" />
                    @if (Model.IsNew)
                    {
                        <mh-field name="Kind" kind="radios" label="@L["Images.Kind"]" value="@Model.Kind" options="Model.Kinds" />
                    }
                    else
                    {
                        <input type="hidden" name="Kind" value="@Model.Kind" />
                    }
                    <mh-field name="KernelArguments" kind="textarea" label="@L["Images.KernelArguments"]" value="@Model.KernelArguments" mono rows="3" optional show-if="Kind" show-value="Linux"
                              placeholder="ip=dhcp url={answer} hostname={hostname}" hint="@L["Images.KernelArguments.Hint"]" disabled="@ro" />
                </div>
            </div>
            @if (Model.CanManage)
            {
                <mh-buttons save="@L[Model.IsNew ? "Common.Create" : "Common.Save"]" back="/rollout/images" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="@L["Images.Delete"]" delete-confirm="@L["Images.DeleteConfirm", Model.Name]" />
            }
            else
            {
                <mh-buttons back="/rollout/images" />
            }
        </form>
    </div>
    @if (!Model.IsNew)
    {
        <div class="mat-col-12 mat-col-lg-6">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("upload")@L["Images.Files"]</h2></div>
                <div class="mat-card__body">
                    <p class="mat-hint">@L["Images.Files.Hint." + Model.Kind]</p>
                    <ul class="mat-itemlist">
                        @foreach (var (file, size) in Model.Files)
                        {
                            <li class="mat-item">
                                <div class="mat-item__main">
                                    <span class="mat-item__lead">@Ui.Icon(size is null ? "alert" : "check-circle")</span>
                                    <span class="mat-item__body"><span class="mat-item__title mat-mono">@file</span><span class="mat-item__text">@(size is { } s ? Ui.Bytes(s) : L["Images.NotThere"].Value)</span></span>
                                </div>
                                @if (Model.CanManage)
                                {
                                    <form class="mat-item__aside mh-upload-row" method="post" asp-page-handler="Upload" asp-route-id="@Model.Id" enctype="multipart/form-data">
                                        <input type="hidden" name="slot" value="@file" />
                                        <label class="mat-sr-only" for="file-@file.Replace('.', '-')">@L["Images.UploadNamed", file]</label>
                                        <input class="mh-file-input" type="file" id="file-@file.Replace('.', '-')" name="file" required />
                                        <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm">@Ui.Icon("upload")<span>@L["Images.Upload"]</span></button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

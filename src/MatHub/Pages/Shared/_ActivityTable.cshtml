@model (IReadOnlyList<ActivityRow> Items, string Zone)
@* The one table of activity: the admin page and the tab of a client. *@
<mh-table caption="@L["Activity.Title"]">
    <thead><tr><th scope="col">@L["Activity.Col.Date"]</th><th scope="col">@L["Activity.Col.Who"]</th><th scope="col">@L["Activity.Col.What"]</th><th scope="col" class="mat-hide-sm">@L["Activity.Col.Item"]</th></tr></thead>
    <tbody>
        @foreach (var a in Model.Items)
        {
            <tr>
                <td data-label="@L["Activity.Col.Date"]" class="mh-nowrap">@Ui.When(a.Date, Model.Zone)</td>
                <td data-label="@L["Activity.Col.Who"]">@(a.UserName ?? L["Activity.System"].Value)</td>
                <td data-label="@L["Activity.Col.What"]"><span class="mat-pill mat-pill--plain">@L["Activity.Area." + a.Area]</span> @L["Activity.Action." + a.Action]</td>
                <td data-label="@L["Activity.Col.Item"]" class="mat-hide-sm">
                    @if (a.ClientId is { } cid)
                    {
                        <a href="/clients/@cid">@a.Target</a>
                    }
                    else
                    {
                        @a.Target
                    }
                    @if (!string.IsNullOrEmpty(a.Detail))
                    {
                        <small class="mh-muted mh-block-line">@a.Detail</small>
                    }
                </td>
            </tr>
        }
    </tbody>
</mh-table>

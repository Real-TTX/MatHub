@page "/jobs/{id:long}"
@model MatHub.Pages.Jobs.DetailModel
@{
    var job = Model.Detail.Job;
    ViewData["Title"] = job.Name;
    ViewData["PageSub"] = L["Jobs.Kind." + job.Kind].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Jobs.Title"].Value, "/jobs"), (job.Name, null) };
    var runs = Model.Detail.Runs;
}

<div class="mat-stack" data-live-target="job" data-live-refresh="@(Model.Busy ? "4" : null)">
    <mh-stats label="@L["Jobs.Runs"]">
        <mh-stat icon="monitor" label="@L["Clients.Title"]" value="@runs.Count.ToString()" />
        <mh-stat icon="check-circle" label="@L["Runs.Status.Succeeded"]" value="@runs.Count(r => r.Status == RunStatus.Succeeded).ToString()" tone="ok" />
        <mh-stat icon="x-circle" label="@L["Runs.Status.Failed"]" value="@runs.Count(r => r.Status == RunStatus.Failed).ToString()" tone="@(runs.Any(r => r.Status == RunStatus.Failed) ? "danger" : null)" />
        <mh-stat icon="clock" label="@L["Jobs.State.Open"]" value="@runs.Count(r => r.Status is RunStatus.Queued or RunStatus.Running).ToString()" tone="@(runs.Any(r => r.Status is RunStatus.Queued or RunStatus.Running) ? "info" : null)" />
    </mh-stats>

    <mh-table caption="@L["Jobs.Runs"]">
        <thead><tr><th scope="col">@L["Clients.One"]</th><th scope="col">@L["Common.Status"]</th><th scope="col" class="mat-hide-sm">@L["Runs.Started"]</th><th scope="col" class="mat-hide-md">@L["Runs.Finished"]</th><th scope="col" class="mat-num mat-hide-sm">@L["Runs.ExitCode"]</th><th scope="col" class="mat-hide-md">@L["Runs.Output"]</th></tr></thead>
        <tbody>
            @foreach (var r in runs)
            {
                <tr>
                    <td data-label="@L["Clients.One"]" class="mat-table__primary"><a href="/jobs/runs/@r.Id"><span class="mh-name">@Ui.Icon("monitor")@r.ClientName</span></a></td>
                    <td data-label="@L["Common.Status"]"><span class="mat-pill mat-pill--@JobUi.Tone(r.Status)">@L[JobUi.StatusKey(r.Status)]</span>@if (Model.Detail.Steps.Count > 0 && r.Status is RunStatus.Queued or RunStatus.Running) { <span class="mh-muted"> · @L["Jobs.StepOf", Math.Min(r.Step + 1, Model.Detail.Steps.Count), Model.Detail.Steps.Count]</span> }</td>
                    <td data-label="@L["Runs.Started"]" class="mat-hide-sm mh-nowrap">@Ui.When(r.Started, Model.Zone)</td>
                    <td data-label="@L["Runs.Finished"]" class="mat-hide-md mh-nowrap">@Ui.When(r.Finished, Model.Zone)</td>
                    <td data-label="@L["Runs.ExitCode"]" class="mat-num mat-mono mat-hide-sm">@r.ExitCode</td>
                    <td data-label="@L["Runs.Output"]" class="mat-mono mat-hide-md mh-output-line">@(r.Output?.Trim().Split('\n').LastOrDefault())</td>
                </tr>
            }
        </tbody>
    </mh-table>
</div>

<div class="mat-cols mh-mt">
    <div class="mat-col-12 mat-col-lg-8">
        @if (Model.Detail.Steps.Count > 0)
        {
            <section class="mat-card" aria-labelledby="job-steps">
                <div class="mat-card__head"><h2 class="mat-card__title" id="job-steps">@Ui.Icon("route")@L["Sequences.Steps"]</h2>@if (job.SequenceId is { } sid) { <a class="mh-head-end mat-btn mat-btn--ghost mat-btn--sm" href="/sequences/edit?id=@sid">@L["Jobs.OpenSequence"]</a> }</div>
                <div class="mat-card__body">
                    <ol class="mh-run-steps">
                        @foreach (var step in Model.Detail.Steps)
                        {
                            <li>@Ui.Icon(MatHub.Services.Jobs.SequenceService.Icon(step.Kind))<span>@step.Name</span>@if (step.ContinueOnError) { <span class="mh-muted">@L["Sequences.ContinueOnError"]</span> }</li>
                        }
                    </ol>
                </div>
            </section>
        }
        @if (Model.Detail.ScriptText is { Length: > 0 } text)
        {
            <details class="mat-card">
                <summary class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("code")@L["Jobs.Payload"]</h2></summary>
                <div class="mat-card__body"><pre class="mat-code mh-preview"><code>@text</code></pre></div>
            </details>
        }
    </div>
    <div class="mat-col-12 mat-col-lg-4">
        <div class="mat-card">
            <div class="mat-card__body">
                <dl class="mh-dl">
                    <dt>@L["Jobs.Col.Created"]</dt><dd>@Dates.Stamp(job.CreateDate, Model.Zone)</dd>
                    <dt>@L["Jobs.Col.By"]</dt><dd>@(Model.Detail.CreatedBy ?? L["Jobs.Origin." + job.Origin].Value)</dd>
                    @if (job.NotBeforeDate is { } start)
                    {
                        <dt>@L["Jobs.StartsAt"]</dt><dd>@Dates.Stamp(start, Model.Zone)</dd>
                    }
                    <dt>@L["Jobs.Timeout"]</dt><dd>@L["Common.Minutes", job.TimeoutSeconds / 60]</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mat-btn-row mh-btn-row">
    @if (Model.CanRetry)
    {
        <form method="post" asp-page-handler="Retry"><button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("refresh")<span>@L["Jobs.Retry"]</span></button></form>
    }
    <a class="mat-btn mat-btn--secondary" href="/jobs">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
    @if (Model.CanCancel)
    {
        <span class="mat-btn-row__spacer"></span>
        <form method="post" asp-page-handler="Cancel"><button type="submit" class="mat-btn mat-btn--danger" data-confirm="@L["Jobs.CancelConfirm"]" data-confirm-ok="@L["Jobs.Cancel"]">@Ui.Icon("stop")<span>@L["Jobs.Cancel"]</span></button></form>
    }
</div>

@section Scripts {
    <script src="~/js/live.js" asp-append-version="true"></script>
}
